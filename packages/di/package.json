{
  "name": "@silent/di",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivlev-dev/silent-framework.git"
  },
  "homepage": "https://github.com/ivlev-dev/silent-framework#readme",
  "bugs": {
    "url": "https://github.com/ivlev-dev/silent-framework/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Async dependency injection container with scopes and compile-time interface wiring",
  "keywords": [
    "dependency-injection",
    "di",
    "scopes",
    "typescript"
  ]
}

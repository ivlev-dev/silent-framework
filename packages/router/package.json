{
  "name": "@ivlev-dev/silent-router",
  "version": "0.11.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ivlev-dev/silent-core": "workspace:*",
    "@ivlev-dev/silent-di": "workspace:*",
    "@ivlev-dev/silent-reactivity": "workspace:*"
  },
  "devDependencies": {
    "@ivlev-dev/silent-swc": "workspace:*",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivlev-dev/silent-framework.git"
  },
  "homepage": "https://github.com/ivlev-dev/silent-framework#readme",
  "bugs": {
    "url": "https://github.com/ivlev-dev/silent-framework/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Client and server routing for Silent Framework: nested routes, guards, lazy loading and history",
  "keywords": [
    "router",
    "routing",
    "history",
    "ssr",
    "frontend"
  ]
}

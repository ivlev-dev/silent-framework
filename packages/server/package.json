{
  "name": "@ivlev-dev/silent-server",
  "version": "0.13.1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pool": {
      "types": "./dist/pool.d.ts",
      "import": "./dist/pool.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@ivlev-dev/silent-core": ">=0.13.0 <0.14.0",
    "@ivlev-dev/silent-di": ">=0.13.0 <0.14.0",
    "@ivlev-dev/silent-reactivity": ">=0.13.0 <0.14.0"
  },
  "devDependencies": {
    "@ivlev-dev/silent-core": "workspace:*",
    "@ivlev-dev/silent-di": "workspace:*",
    "@ivlev-dev/silent-reactivity": "workspace:*",
    "@types/jsdom": "^27.0.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivlev-dev/silent-framework.git"
  },
  "homepage": "https://github.com/ivlev-dev/silent-framework#readme",
  "bugs": {
    "url": "https://github.com/ivlev-dev/silent-framework/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Server-side rendering for Silent Framework without DOM dependencies",
  "keywords": [
    "ssr",
    "server",
    "reactivity",
    "frontend"
  ]
}

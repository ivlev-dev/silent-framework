{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@ivlev-dev/silent-core",
    "paths": {
      "@ivlev-dev/silent-core/jsx-runtime": ["./src/jsx.ts"]
    }
  },
  "include": ["src/jsx.ts", "tests/jsx-typecheck.tsx"]
}
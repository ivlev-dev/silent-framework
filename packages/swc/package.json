{
  "name": "@ivlev-dev/silent-swc",
  "version": "0.5.0",
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "native/*.node"
  ],
  "scripts": {
    "build": "napi build --release --platform --manifest-path ../../crates/silent-node/Cargo.toml --output-dir native",
    "test": "vitest run"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivlev-dev/silent-framework.git"
  },
  "homepage": "https://github.com/ivlev-dev/silent-framework#readme",
  "bugs": {
    "url": "https://github.com/ivlev-dev/silent-framework/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Native SWC addon for Silent Framework compilation",
  "keywords": [
    "swc",
    "rust",
    "napi",
    "compiler"
  ]
}

{
  "name": "@ivlev-dev/silent-validation-vite",
  "version": "0.13.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run && vitest run -c vitest.types.config.ts"
  },
  "dependencies": {
    "magic-string": "^0.30.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "vite": ">=8"
  },
  "devDependencies": {
    "@ivlev-dev/silent-validation": "workspace:*",
    "@ivlev-dev/silent-vite": "workspace:*",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivlev-dev/silent-framework.git"
  },
  "homepage": "https://github.com/ivlev-dev/silent-framework#readme",
  "bugs": {
    "url": "https://github.com/ivlev-dev/silent-framework/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Vite plugin for Silent Validation: generates runtime schemas from TypeScript accessor types",
  "keywords": [
    "vite",
    "plugin",
    "validation",
    "typescript",
    "schema"
  ]
}

{
  "name": "@ivlev-dev/silent-form",
  "version": "0.12.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@ivlev-dev/silent-core": ">=0.12.0 <0.13.0",
    "@ivlev-dev/silent-reactivity": ">=0.12.0 <0.13.0",
    "@ivlev-dev/silent-validation": ">=0.12.0 <0.13.0"
  },
  "devDependencies": {
    "@ivlev-dev/silent-core": "workspace:*",
    "@ivlev-dev/silent-reactivity": "workspace:*",
    "@ivlev-dev/silent-validation": "workspace:*",
    "@ivlev-dev/silent-swc": "workspace:*",
    "@ivlev-dev/silent-vite": "workspace:*",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivlev-dev/silent-framework.git"
  },
  "homepage": "https://github.com/ivlev-dev/silent-framework#readme",
  "bugs": {
    "url": "https://github.com/ivlev-dev/silent-framework/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Reactive class-based forms on top of silent-validation and silent-core",
  "keywords": [
    "forms",
    "validation",
    "reactivity",
    "decorators",
    "typescript"
  ]
}

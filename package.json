{
  "name": "silent-framework",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "build:native": "pnpm --filter @ivlev-dev/silent-swc build",
    "test": "cargo test -p silent-transform && pnpm -r --filter \"./packages/**\" --if-present test",
    "typecheck": "pnpm -r --filter \"./packages/**\" --if-present typecheck && tsc -p packages/core/tsconfig.typecheck.json && pnpm --filter @ivlev-dev/silent-example-counter typecheck && pnpm --filter @ivlev-dev/silent-example-ssr-counter typecheck && pnpm --filter @ivlev-dev/silent-bench exec tsc --noEmit -p tsconfig.json",
    "dev": "pnpm --filter @ivlev-dev/silent-example-counter dev",
    "build:example": "pnpm --filter @ivlev-dev/silent-example-counter build",
    "bench": "pnpm --filter @ivlev-dev/silent-bench bench",
    "bench:ssr": "pnpm --filter @ivlev-dev/silent-bench bench:ssr",
    "bench:build": "pnpm --filter @ivlev-dev/silent-bench exec tsx src/build-bench.ts",
    "bench:hydrate": "pnpm --filter @ivlev-dev/silent-bench exec tsx --conditions=browser src/hydrate-bench.ts",
    "bench:browser": "pnpm --filter @ivlev-dev/silent-bench exec tsx src/browser-bench.ts",
    "bench:profile": "pnpm --filter @ivlev-dev/silent-bench exec tsx src/browser-profile.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "test:ssr": "node scripts/ssr-e2e.mjs",
    "install:check": "node scripts/install-check.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "api:check": "node scripts/api-check.mjs",
    "deprecate:legacy": "node scripts/deprecate-legacy.mjs",
    "version:bump": "node scripts/version.mjs",
    "version:check": "node scripts/verify-versions.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@ivlev-dev/silent-server": "workspace:*",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "tinybench": "^6.2.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "playwright-core": "^1.65.0"
  }
}
